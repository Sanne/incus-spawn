<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.incusspawn</groupId>
        <artifactId>incus-spawn-parent</artifactId>
        <version>0.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>incus-spawn-proxy</artifactId>
    <name>incus-spawn-proxy</name>
    <description>MITM authentication proxy for incus-spawn</description>

    <properties>
        <native.optimization>-O3</native.optimization>
<!-- serial everywhere but Linux (the linux-g1 profile). On macOS aarch64 that is measured, not a
     leftover: G1 builds there since Oracle GraalVM 25.1, and gave the same throughput as serial for a
     binary 9 MB larger and more memory (docs/dev/PERFORMANCE-NOTES.md, "G1 on Apple Silicon", #1140).
     It is also Oracle-only there, so it would fail a native build with GraalVM CE. -->
        <proxy.native.gc>serial</proxy.native.gc>
<!-- What the proxy takes as physical memory; the collector's maximum heap is a share of it (G1 25%,
     serial 80%). One value for every platform; a property so that a benchmark can build another. -->
        <proxy.native.max.ram>256m</proxy.native.max.ram>
<!-- Bake os.name at build time to avoid a uname() syscall; macOS doesn't need this (already a build-time constant in GraalVM) -->
        <svm.target.name.args/>
<!-- Empty by default: -march values are architecture-specific, and passing an x86 one to an aarch64 build fails (or vice versa). Set by the arch-gated profiles below. -->
        <native.march.args/>
<!-- Empty unless a PGO profile below is active. -->
        <native.pgo.args/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.incusspawn</groupId>
            <artifactId>incus-spawn-common</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.incusspawn</groupId>
            <artifactId>incus-spawn-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.smallrye</groupId>
                    <artifactId>smallrye-fault-tolerance-vertx</artifactId>
                </exclusion>
                <exclusion>
                    <!-- Vert.x 5 pulls Jackson 3 databind for its JSON codec, which we never use;
                         it would ship a second databind (plus the JDK XML stack) in the image. -->
                    <groupId>tools.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.aayushatharva.brotli4j</groupId>
            <artifactId>brotli4j</artifactId>
            <version>1.23.0</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <!-- Test doubles still speak Jackson. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                            <goal>native-image-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Stamps git.commit.id (BuildInfo) by asking git, which resolves a git worktree to
                     its own HEAD. git-commit-id-maven-plugin maps a worktree to its main clone and
                     stamped that clone's HEAD instead (#1169). -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>git-commit-id</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>git</executable>
                            <arguments>
                                <argument>log</argument>
                                <argument>-1</argument>
                                <argument>--no-show-signature</argument>
                                <argument>--format=git.commit.id=%H</argument>
                            </arguments>
                            <outputFile>${project.build.outputDirectory}/git.properties</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
          Profile-guided optimization (docs/dev/PGO.md, #1637). -Dnative.pgo=DIR builds with the
          profiles in DIR, an absolute path (proxy.iprof.gz here; the release's profiles job publishes it),
          -Dnative.pgo.instrument builds the instrumented binary that bench/pgo-collect.sh collects
          them with. Oracle GraalVM only, like G1 on macOS; without either a build is unprofiled,
          so a Community Edition build from source still works. The pgo and pgo-instrument
          profiles are duplicated in cli/pom.xml: change both together.
        -->
        <profile>
            <id>pgo</id>
            <activation>
                <property><name>native.pgo</name></property>
            </activation>
            <properties>
                <native.pgo.args>,--pgo=${native.pgo}/proxy.iprof.gz,-H:+UnlockExperimentalVMOptions,-H:+PGOPrintProfileQuality,-H:-UnlockExperimentalVMOptions</native.pgo.args>
            </properties>
        </profile>
        <profile>
            <!-- -H:+ParseRuntimeOptions undoes the list's -H:-ParseRuntimeOptions for this build only:
                 each process needs -XX:ProfilesDumpFile to write a profile of its own. -->
            <id>pgo-instrument</id>
            <activation>
                <property><name>native.pgo.instrument</name></property>
            </activation>
            <properties>
                <native.pgo.args>,--pgo-instrument,-H:+ParseRuntimeOptions</native.pgo.args>
            </properties>
        </profile>
<!-- The -march profiles (x86-march-amd64, x86-march-x86_64, aarch64-march) are duplicated in cli/pom.xml: change both together, same ids, activation and values. -->
        <!--
          GraalVM's default -march=x86-64-v3 does NOT include AES or CLMUL, so the
          native image cannot use AES-NI/GHASH intrinsics and TLS bulk encryption
          falls back to software AES. Since every byte through this proxy is
          AES-GCM encrypted on both legs, that costs ~13x: measured 73 MB/s at v3
          vs 960 MB/s at haswell serving a cached Maven artifact.

          haswell is v3 + AES + CLMUL, and costs no reach at all: AES-NI shipped in
          2010, three years before the AVX2/BMI2 that v3 already requires, so every
          CPU able to run a v3 build already has it.

          skylake (haswell + ADX) was measured and is indistinguishable — 1530 vs
          1514 req/s over three interleaved rounds, with the ordering reversing
          between rounds. ADX buys nothing here, so there is no reason to pay its
          narrowing (it would drop Intel Haswell 2013-14 and AMD Excavator).

          Do NOT "upgrade" this to x86-64-v4: the numbered levels never include
          AES, so v4 measures identically to v3 (73 MB/s) while dropping all
          non-AVX-512 hardware.
        -->
        <profile>
            <id>x86-march-amd64</id>
            <activation>
                <os><arch>amd64</arch></os>
            </activation>
            <properties>
                <native.march.args>,-march=haswell</native.march.args>
            </properties>
        </profile>
        <profile>
            <!-- Same, for JVMs reporting os.arch as x86_64 (macOS Intel). -->
            <id>x86-march-x86_64</id>
            <activation>
                <os><arch>x86_64</arch></os>
            </activation>
            <properties>
                <native.march.args>,-march=haswell</native.march.args>
            </properties>
        </profile>
        <profile>
            <!--
              aarch64 (Apple Silicon, Linux arm64): GraalVM's default armv8.1-a has no
              AES or PMULL either, so TLS ran as software AES here too: 74 MB/s vs
              627 MB/s for the proxy on an Apple Silicon Mac (#1144). The "+aes" modifier
              enables AES *and* PMULL, i.e. the GHASH intrinsic as well. GraalVM has no
              runtime CPU dispatch on aarch64 at all, so this can only be chosen at build
              time. Every Apple Silicon Mac has both; on Linux it drops ARMv8.1+ cores built
              without the optional crypto extension, which exit at startup with GraalVM's
              CPU-feature error and can use a JVM install instead. (The Raspberry Pi 3/4
              were already excluded: ARMv8.0, so no LSE for the default armv8.1-a.)
              Keep armv8.1-a (the default) as the base, not compatibility, so LSE stays on.
            -->
            <id>aarch64-march</id>
            <activation>
                <os><arch>aarch64</arch></os>
            </activation>
            <properties>
                <native.march.args>,-march=armv8.1-a+aes</native.march.args>
            </properties>
        </profile>
        <profile>
            <id>linux-g1</id>
            <activation>
                <os><name>linux</name></os>
            </activation>
            <properties>
                <proxy.native.gc>G1</proxy.native.gc>
                <svm.target.name.args>,-Dsvm.targetName=Linux</svm.target.name.args>
            </properties>
        </profile>
    </profiles>
</project>
