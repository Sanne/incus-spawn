[50.9757, "o", "\u001b[H\u001b[38;5;246m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m4\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m5\u001b[15G\u001b[22m\u001b[38;5;242m/** Applies a percentage discount to a price. */\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m6\u001b[11G\u001b[22m    \u001b[38;5;197mpublic\u001b[38;5;231m \u001b[38;5;197mstatic\u001b[38;5;231m \u001b[38;5;148mdouble\u001b[38;5;231m \u001b[38;5;148mapplyDiscount\u001b[38;5;208m(\u001b[38;5;148mdouble\u001b[38;5;208m price, \u001b[38;5;148mdouble\u001b[38;5;208m dis\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;208mcountPercent)\u001b[38;5;231m {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m  7 -\u001b[38;5;231m        return price + price * (discountPercent / 100.0);      \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m  7 +\u001b[38;5;231m        \u001b[38;5;197mreturn\u001b[38;5;231m price \u001b[48;5;28m-\u001b[48;5;22m price * (discountPercent / \u001b[38;5;141m100.0\u001b[38;5;231m);      \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m8\u001b[11G\u001b[22m    }\r\u001b[6C\u001b[1B\u001b[2m 9\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 10 \u001b[22m     \u001b[38;5;242m/** Adds VAT to a net price. */\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[2"]
[50.9757, "o", "2m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39mI fixed the\u001b[15Gbug and committed it\u001b[36Gas\u001b[39G\u001b[38;5;153m07c2589\u001b[39m.\u001b[48GThe\u001b[52Gtest\u001b[57Gsuite\u001b[63Gnow\u001b[67Gpasses,\u001b[75Gwith\r\u001b[2C\u001b[1Bno\u001b[6Gfailures\u001b[15Gin\u001b[18Gthe\u001b[22GMaven\u001b[28Goutput.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mapplyDiscount\u001b[39m in \u001b[38;5;153mPriceCalculator.java\u001b[39m added the discount t\u001b[62G the pri\u001b[71Ge instead\r\u001b[2C\u001b[1Bof subtrac\u001b[14Ging it. A 10% discoun\u001b[37Gon 100\u001b[44Ggave 110 instead\u001b[61Gof\u001b[64G90.\u001b[68GI\u001b[70Gchanged\r\u001b[2C\u001b[1B\u001b[38;5;153mprice + …\u001b[13G\u001b[39mto\u001b[16G\u001b[38;5;153mprice - …\u001b[39m.\u001b[27GI\u001b[29Ghaven't\u001b[37Gpushed\u001b[44Ganything.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GCooked for 10s · done 10:22 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m❯ \u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;5;244m────────────"]
