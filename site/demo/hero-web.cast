[50.3078, "o", "\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m  4 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m  5 \u001b[22m     \u001b[38;5;242m/** Applies a percentage discount to a price. */\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m  6 \u001b[22m     \u001b[38;5;197mpublic\u001b[38;5;231m \u001b[38;5;197mstatic\u001b[38;5;231m \u001b[38;5;148mdouble\u001b[38;5;231m \u001b[38;5;148mapplyDiscount\u001b[38;5;208m(\u001b[38;5;148mdouble\u001b[38;5;208m price, \u001b[38;5;148mdouble\u001b[38;5;208m dis\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m \u001b[11G\u001b[22m\u001b[38;5;208mcountPercent)\u001b[38;5;231m {\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m  7 -\u001b[38;5;231m        return price + price * (discountPercent / 100.0);      \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m  7 +\u001b[38;5;231m        \u001b[38;5;197mreturn\u001b[38;5;231m price \u001b[48;5;28m-\u001b[48;5;22m price * (discountPercent / \u001b[38;5;141m100.0\u001b[38;5;231m);      \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m8\u001b[11G\u001b[22m    }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m  9 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 10 \u001b[22m     \u001b[38;5;242m/** Adds VAT to a net price. */\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39mI\u001b[5Gfixed\u001b[11Gthe\u001b["]
[50.3078, "o", "15Gbug\u001b[19Gand\u001b[23Gcommitted\u001b[33Git\u001b[36Gas\u001b[39G\u001b[38;5;153m07c2589\u001b[39m.\u001b[48GThe\u001b[52Gtest\u001b[57Gsuite\u001b[63Gnow\u001b[67Gpasses,\u001b[75Gwith\r\u001b[1B \u001b[3Gno failures in the Maven\u001b[28Goutput.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mapplyDiscount\u001b[39m in \u001b[38;5;153mPriceCalculator.java\u001b[39m added the discount to the price instead\r\u001b[2C\u001b[1Bof\u001b[6Gsubtracting it. A 10% discount on 100 gave 110 instead of 90. I changed\r\u001b[2C\u001b[1B\u001b[38;5;153mprice + …\u001b[39m to \u001b[38;5;153mprice - …\u001b[39m.\u001b[27GI\u001b[29Ghaven't\u001b[37Gpushed\u001b[44Ganything.\r\u001b[2B\u001b[38;5;246m✻\u001b[3GCooked for 10s · done 10:22 PM\u001b[39m\u001b[K\r\u001b[3B❯ \u001b[26;1H\u001b[23;3H"]
