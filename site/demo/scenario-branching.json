[
 {
  "wait": "\u279c \\Z",
  "timeout": 15
 },
 {
  "sleep": 0.8
 },
 {
  "type": "# 'workbench' has expensive state: postgres, 100k rows, warm caches.\n"
 },
 {
  "wait": "\u279c \\Z",
  "timeout": 10
 },
 {
  "sleep": 0.6
 },
 {
  "type": "# fork it into 'exp-a', and time it:\n"
 },
 {
  "wait": "\u279c \\Z",
  "timeout": 10
 },
 {
  "sleep": 0.6
 },
 {
  "type": "time isx branch --from workbench exp-a --format=plain\n"
 },
 {
  "wait": "\u279c \\Z",
  "timeout": 90
 },
 {
  "sleep": 1.2
 },
 {
  "type": "# that's the whole fork: a running copy, database and all. step in:\n"
 },
 {
  "wait": "\u279c \\Z",
  "timeout": 10
 },
 {
  "sleep": 0.6
 },
 {
  "type": "isx shell exp-a\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 60
 },
 {
  "sleep": 1.0
 },
 {
  "type": "# same data?\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 10
 },
 {
  "sleep": 0.6
 },
 {
  "type": "psql -c 'select count(*) from orders'\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 30
 },
 {
  "sleep": 1.0
 },
 {
  "type": "# yes. now a destructive experiment, in exp-a only:\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 10
 },
 {
  "sleep": 0.6
 },
 {
  "type": "psql -c 'drop table orders'\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 15
 },
 {
  "sleep": 0.8
 },
 {
  "type": "# exp-a is wrecked. leave it, and fork workbench again:\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 10
 },
 {
  "sleep": 0.6
 },
 {
  "type": "exit\n"
 },
 {
  "wait": "\u279c \\Z",
  "timeout": 30
 },
 {
  "type": "time isx branch --from workbench exp-b --format=plain\n"
 },
 {
  "wait": "\u279c \\Z",
  "timeout": 90
 },
 {
  "sleep": 1.2
 },
 {
  "type": "isx shell exp-b\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 60
 },
 {
  "sleep": 1.0
 },
 {
  "type": "# exp-b is a fresh copy of workbench, untouched by exp-a:\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 10
 },
 {
  "sleep": 0.6
 },
 {
  "type": "psql -c 'select count(*) from orders'\n"
 },
 {
  "wait": "\u276f \\Z",
  "timeout": 30
 },
 {
  "sleep": 1.2
 },
 {
  "type": "# every fork is instant, and no experiment touches another.  \u220e"
 },
 {
  "sleep": 2.5
 }
]
