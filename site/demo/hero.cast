[70.186, "o", "\u001b[H\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mThe test suite fails. Find the bug, fix it, run the tests, and commit the \u001b[39m    \r\u001b[1B  \u001b[38;5;231mfix.\u001b[39m                                                                          \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B  \u001b[38;5;246mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;5;114m●\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(src/main/java/demo/PriceCalculator.java)\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m  4 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m  5 \u001b[22m     \u001b[38;5;242m/** Applies a percentage discount to a price. */\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;231m\u001b[2m  6 \u001b[22m     \u001b[38;5;197mpublic\u001b[38;5;231m \u001b[38;5;197mstatic\u001b[38;5;231m \u001b[38;5;148mdouble\u001b[38;5;231m \u001b[38;5;148mapplyDiscount\u001b[38;5;208m(\u001b[38;5;148mdouble\u001b[38;5;208m price, \u001b[38;5;148mdouble\u001b[38;5;208m dis\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;208mcountPercent)\u001b[38;5;231m {\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m  7 -\u001b[38;5;231m        return price + price * (discountPercent / 100"]
[70.186, "o", ".0);      \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m  7 +\u001b[38;5;231m        \u001b[38;5;197mreturn\u001b[38;5;231m price \u001b[48;5;28m-\u001b[48;5;22m price * (discountPercent / \u001b[38;5;141m100.0\u001b[38;5;231m);      \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;231m\u001b[2m  8 \u001b[22m     }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m  9 \u001b[22m \r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m     \u001b[38;5;242m/** Adds VAT to a net price. */\r\u001b[2B\u001b[38;5;246m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\u001b[26;1H\u001b[23;3H"]
