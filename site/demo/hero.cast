[70.7596, "o", "\u001b[H\u001b[K\r\u001b[1B\u001b[38;5;114m●\u001b[39m \u001b[1mUpdate\u001b[22m(src/main/java/demo/PriceCalculator.java)\u001b[K\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[2C\u001b[1B   \u001b[38;5;231m\u001b[2m  4 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m  5 \u001b[22m     \u001b[38;5;242m/** Applies a percentage discount to a price. */\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m  6 \u001b[22m     \u001b[38;5;197mpublic\u001b[38;5;231m \u001b[38;5;197mstatic\u001b[38;5;231m \u001b[38;5;148mdouble\u001b[38;5;231m \u001b[38;5;148mapplyDiscount\u001b[38;5;208m(\u001b[38;5;148mdouble\u001b[38;5;208m price, \u001b[38;5;148mdouble\u001b[38;5;208m dis\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;208mcountPercent)\u001b[38;5;231m {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m  7 -\u001b[38;5;231m        return price + price * (discountPercent / 100.0);      \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m  7 +\u001b[38;5;231m        \u001b[38;5;197mreturn\u001b[38;5;231m price \u001b[48;5;28m-\u001b[48;5;22m price * (discountPercent / \u001b[38;5;141m100.0\u001b[38;5;231m);      \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m8\u001b[15G\u001b[22m}\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m9\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[3"]
[70.7596, "o", "8;5;231m\u001b[2m 10 \u001b[22m     \u001b[38;5;242m/** Adds VAT to a net price. */\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m●\u001b[3G\u001b[39mRunning cd ~/demo-app\u001b[25G&&\u001b[28Gmvn\u001b[32G-q\u001b[35Gtest\u001b[40G2>&1\u001b[45G|\u001b[47Gtail\u001b[52G-15\u001b[56G&&\u001b[59Gg…\r\u001b[1B\u001b[38;5;246m  ⎿  $ cd ~/demo-app && mvn -q test 2>&1 | tail -15 && git add -A src && git \r\u001b[5C\u001b[1Bcommit -q -m \"Fix applyDiscount adding instead of subtracting the discount\r\u001b[5C\u001b[1BCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>\" && git log \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;246m--oneline -1\u001b[19G\u001b[39m\u001b[K\u001b[26;1H\u001b[23;3H"]
