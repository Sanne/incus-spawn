# Cloudflare Pages response headers: https://developers.cloudflare.com/pages/configuration/headers/

# Casts are newline-delimited JSON. Served as application/octet-stream (the
# default for an unknown extension), Cloudflare does not compress them;
# as text they shrink about 7x.
/casts/*
  Content-Type: text/plain; charset=utf-8

# The schemas editors fetch by URL: served as JSON Schema, readable from a browser-based editor too.
/schema/*
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *

# Versioned file names: a change ships under a new name, so browsers may keep these.
# style.css and copy.js are linked as <name>?v=<content hash> (build.sh), so they count as versioned too.
/style.css
  Cache-Control: public, max-age=31536000, immutable
/copy.js
  Cache-Control: public, max-age=31536000, immutable
/vendor/asciinema-player-*
  Cache-Control: public, max-age=31536000, immutable
/vendor/fonts/*
  Cache-Control: public, max-age=31536000, immutable
