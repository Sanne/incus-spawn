{
  "list_templates" : {
    "type" : "object",
    "properties" : {
      "templates" : {
        "description" : "Approved templates; empty when none are",
        "type" : "array",
        "items" : {
          "type" : "object",
          "properties" : {
            "template" : {
              "type" : "string"
            },
            "description" : {
              "type" : "string"
            },
            "built" : {
              "type" : "boolean"
            },
            "stale" : {
              "description" : "Built from a definition that has changed since",
              "type" : "boolean"
            },
            "tools" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "supports_delegate" : {
              "type" : "boolean"
            },
            "permission_mode" : {
              "description" : "The delegated agent's permission mode",
              "type" : "string"
            },
            "delegate_model" : {
              "description" : "The delegated agent's default model",
              "type" : "string"
            }
          },
          "required" : [ "template", "description", "built", "stale", "tools", "supports_delegate" ],
          "additionalProperties" : false
        }
      },
      "max_instances" : {
        "type" : "integer"
      },
      "max_concurrent_tasks" : {
        "type" : "integer"
      },
      "orphan_grace_hours" : {
        "type" : "integer"
      },
      "delegate_max_turns" : {
        "type" : "integer"
      }
    },
    "required" : [ "templates", "max_instances", "max_concurrent_tasks", "orphan_grace_hours" ],
    "additionalProperties" : false
  },
  "create_instance" : {
    "type" : "object",
    "properties" : {
      "instance" : {
