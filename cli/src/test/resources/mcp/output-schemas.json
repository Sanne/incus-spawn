        "type" : "boolean"
      }
    },
    "required" : [ "instance", "template", "workdir", "tools", "supports_delegate" ],
    "additionalProperties" : false
  },
  "list_instances" : {
    "type" : "object",
    "properties" : {
      "instances" : {
        "type" : "array",
        "items" : {
          "type" : "object",
          "properties" : {
            "instance" : {
              "type" : "string"
            },
            "template" : {
              "type" : "string"
            },
            "purpose" : {
              "type" : "string"
            },
            "created" : {
              "description" : "ISO-8601",
              "type" : "string"
            },
            "state" : {
              "description" : "creating or ready: held by this session; held: by another live session; orphaned: by none, adopt_instance takes it",
              "type" : "string",
              "enum" : [ "creating", "ready", "held", "orphaned" ]
            },
            "kept" : {
              "type" : "boolean"
            },
            "held_by" : {
              "description" : "The session holding it, as <pid>-<start>",
              "type" : "string"
            },
            "held_by_client" : {
              "description" : "The MCP client of that session",
              "type" : "string"
            },
            "orphaned_since" : {
              "description" : "ISO-8601",
              "type" : "string"
            },
            "orphan_until" : {
              "description" : "ISO-8601: destroyed after this unless adopted",
              "type" : "string"
            },
            "tasks" : {
              "description" : "This session's tasks in it",
              "type" : "array",
              "items" : {
                "type" : "object",
                "properties" : {
                  "task_id" : {
                    "type" : "string"
                  },
                  "kind" : {
                    "type" : "string",
                    "enum" : [ "agent", "command" ]
                  },
                  "state" : {
                    "description" : "As this session last saw it; unknown: nothing has read how it ended (as after cancel_task). task_status reads it now",
                    "type" : "string",
                    "enum" : [ "running", "finished", "attached", "lost", "unknown" ]
                  }
                },
                "required" : [ "task_id", "kind", "state" ],
                "additionalProperties" : false
              }
            }
          },
          "required" : [ "instance", "template", "state", "kept", "tasks" ],
          "additionalProperties" : false
        }
      }
    },
    "required" : [ "instances" ],
    "additionalProperties" : false
  },
  "adopt_instance" : {
    "type" : "object",
    "properties" : {
      "instance" : {
        "type" : "string"
      },
      "template" : {
        "type" : "string"
      },
      "purpose" : {
        "type" : "string"
      },
      "supports_delegate" : {
        "type" : "boolean"
      },
      "tasks" : {
        "description" : "Ids of its tasks, now this session's",
        "type" : "array",
        "items" : {
          "type" : "string"
        }
      },
      "warning" : {
        "description" : "Why its tasks could not be read",
        "type" : "string"
      }
    },
    "required" : [ "instance", "template", "supports_delegate", "tasks" ],
    "additionalProperties" : false
  },
  "exec" : {
    "type" : "object",
    "properties" : {
      "background" : {
        "description" : "Started as a task: only task_id, instance and kind are set",
        "type" : "boolean"
      },
      "task_id" : {
        "type" : "string"
      },
      "instance" : {
        "type" : "string"
      },
      "kind" : {
        "type" : "string",
        "enum" : [ "command" ]
      },
      "exit_code" : {
        "description" : "-1 when isx lost track of the command",
        "type" : "integer"
      },
      "duration_ms" : {
        "type" : "integer"
      },
      "timed_out" : {
        "description" : "Killed by timeout_seconds",
        "type" : "boolean"
      },
      "cancelled" : {
        "type" : "boolean"
      },
      "stdout" : {
        "description" : "The end of it, when not asked about",
        "type" : "string"
      },
      "stderr" : {
        "description" : "The end of it, when not asked about",
        "type" : "string"
      },
      "stdout_bytes" : {
        "description" : "Its whole length",
        "type" : "integer"
      },
      "stderr_bytes" : {
        "description" : "Its whole length",
        "type" : "integer"
      },
      "truncated" : {
        "description" : "stdout or stderr is only the end of it",
        "type" : "boolean"
      },
      "answer" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "description" : "A model's reading of the text: untrusted and lossy",
            "type" : "string"
          },
          "summarised" : {
            "description" : "What it read, e.g. '12 lines, 345 bytes'",
            "type" : "string"
          }
        },
        "required" : [ "text", "summarised" ],
        "additionalProperties" : false
      }
    },
    "required" : [ "background" ],
    "additionalProperties" : false
  },
