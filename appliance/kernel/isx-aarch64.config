# incus-spawn appliance kernel: aarch64-only options.
# Concatenated onto isx.config by build-kernel.sh. Only options that would be
# wrong or dead on x86_64 belong here; everything shared stays in isx.config.

# ---- PCI host bridge ----
# The generic ECAM host bridge is how both QEMU/virt and vfkit expose PCI.
CONFIG_PCI_HOST_GENERIC=y

# ---- Serial: ttyAMA0 ----
# QEMU/virt's console. Under vfkit the console is hvc0 (virtio-console)
# instead, but PL011 costs little and keeps one kernel working on both.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# No 8250. There is no 16550-compatible UART on either aarch64 target, but the
# driver does not know that: serial8250_isa_init_ports() registers
# CONFIG_SERIAL_8250_NR_UARTS ports unconditionally, so /dev/ttyS0..3 appear as
# backing-less stubs that accept writes and discard them -- costing an idle
# getty from rcS and, historically, the output of incus-spawn-diag and
# incus-spawn-smoke-test, which used to pick the first tty that existed.
#
# Note this is only half the story, and not the load-bearing half: x86_64 still
# builds 8250, so the same stubs exist there under vfkit on an Intel Mac, where
# the real console is also hvc0. The actual fix for that is in the scripts,
# which now read console= from /proc/cmdline instead of probing. Dropping the
# driver here is worth doing on its own terms -- dead code on this arch, and a
# /dev that does not lie -- but do not rely on it to keep console selection
# honest.
CONFIG_SERIAL_8250=n
CONFIG_SERIAL_8250_CONSOLE=n

# ---- RTC: PL031, as provided by QEMU/virt ----
CONFIG_RTC_DRV_PL031=y

# ---- Auto-selected by the arch, listed for documentation ----
# ARM_GIC_V3 (and GICv2/v5, COMMON_CLK, OF, POWER_SUPPLY) are selected by
# arch/arm64/Kconfig and cannot be turned off from a fragment.
