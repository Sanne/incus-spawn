# incus-spawn VM base image kernel: options shared by both arches.
# build-kernel.sh vm concatenates isx.config, isx-<arch>.config, this file and
# vm-<arch>.config, in that order, so a vm fragment can override an appliance
# default. The appliance role never reads it.
#
# This kernel is the base VM image's own (#1255): OVMF/AAVMF load it straight
# from the ESP as EFI/BOOT/BOOTX64.EFI (BOOTAA64.EFI), with no boot loader, no
# initrd and no modules, and it mounts a Fedora root on virtio-blk. The command
# line is built in (vm-<arch>.config), since nothing else passes one.
#
# The rule: a feature goes in when a template asks for it. Deliberately absent:
#   - MODULES: the image ships no module files, only the index of built-in
#     drivers (build-kernel.sh), so that modprobe finds those.
#   - device-mapper, XFS, squashfs, NVMe: the root is ext4 on virtio-blk.
#   - VFAT and NLS: the ESP is never mounted; the firmware reads it, not Linux.
#   - VT: the console is serial, and a VT measured nothing (isx.config).

# ---- Root filesystem: ext4 ----
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
# root=PARTLABEL= is resolved by the kernel itself, from the GPT partition
# name, so no initrd and no udev are needed to find the root.
CONFIG_EFI_PARTITION=y

# ---- EFI: the kernel is the EFI application the firmware starts ----
# The stub itself is arch-specific (vm-<arch>.config).
CONFIG_EFI=y

# ---- SMBIOS: the machine-id ----
# systemd reads /sys/class/dmi/id/product_uuid for the machine-id, which Incus
# makes anew for every copy; without DMI the ID is random (#1483, design/instances.md
# "Branching").
CONFIG_DMI=y
CONFIG_DMIID=y

# systemd's proc-sys-fs-binfmt_misc.automount.
CONFIG_AUTOFS_FS=y

# Writes to a mounted block device. Without it the kernel refuses any O_RDWR open
# of the mounted root, and resize2fs, which opens it that way even to grow the
# filesystem online, fails with EBUSY: isx's VM build grows the root that way.
CONFIG_BLK_DEV_WRITE_MOUNTED=y

# ---- PCI interrupts: MSI ----
# Without it every virtio device and PCIe port shares one legacy INTx line, and
# each interrupt runs all their handlers. Under Incus (nested KVM) the agent's
# 9p copy of incus-agent took 5.1 s instead of 0.9 s, so the agent came up
# seconds later than on Fedora's kernel. On arm64, PCI selects the GICv3 ITS
# that delivers them.
CONFIG_PCI_MSI=y

# ---- PCI hotplug ----
# Incus attaches each disk device a running VM gets, and detaches it, by PCIe
# hotplug on the root port it reserved: isx's builds add and remove the dnf
# cache share and repository references that way. Without a driver for it the
# guest never answers the unplug, and Incus gives up on the detach after 10 s.
# QEMU's q35 announces hotplug through ACPI, the PCIe ports natively; both.
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y

# ---- Power button ----
# incus stop without --force, and isx's own stops, press the VM's ACPI power
# button and wait for the guest to shut down. systemd-logind takes the key from
# an evdev input device, which the ACPI button driver provides; without them
# the guest ignores it and the stop times out.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_ACPI_BUTTON=y

# ---- Nested virtualization: Incus VMs inside a --kvm branch ----
# The vendor KVM drivers are per-arch (vm-x86_64.config).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y

# ---- Incus agent's config share ----
# Incus offers the agent's config drive over 9p and virtiofs; VIRTIO_FS is
# already in isx.config.
# 9P_FS sits under the network filesystems menu.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
