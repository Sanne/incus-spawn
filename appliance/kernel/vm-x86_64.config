# incus-spawn VM base image kernel: x86_64-only options.
# Concatenated last by build-kernel.sh vm, after vm.config.

# ---- EFI stub ----
# OVMF loads the bzImage as a PE application. The handover protocol is the
# entry point OVMF's loader takes for a Linux image; RELOCATABLE lets the stub
# run the kernel where the firmware placed it.
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y
CONFIG_RELOCATABLE=y

# ---- Nested virtualization ----
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
# Both default to y but are prompts, so allnoconfig turns them off. Without the
# in-kernel I/O APIC and PIC, QEMU cannot create a VM's irqchip ("Create kernel
# irqchip failed: Inappropriate ioctl for device") and Incus reports VMs as
# unsupported. SMM is what a Secure Boot OVMF needs, and Incus VMs have Secure
# Boot on unless told otherwise.
CONFIG_KVM_IOAPIC=y
CONFIG_KVM_SMM=y

# ---- Built-in command line ----
# Nothing passes one: the firmware starts the kernel from the removable-media
# path with no load options. The root is found by its GPT partition name
# (isx-root), which the image build sets. TERM=dumb reaches PID 1's
# environment: with it, systemd stops querying a serial console nothing
# answers, about 0.7 s per boot. loglevel=5 keeps the kernel's notices off the
# console. No console=tty1: VT is off. Keep ro: a root writable when PID 1
# sets up the machine-id gets the ID written into it, which copies then share
# (#1483, design/instances.md "Branching").
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="root=PARTLABEL=isx-root rootfstype=ext4 rootwait ro console=ttyS0 loglevel=5 TERM=dumb"
CONFIG_CMDLINE_OVERRIDE=y
