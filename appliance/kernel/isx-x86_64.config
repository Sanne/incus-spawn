# incus-spawn appliance kernel: x86_64-only options.
# Concatenated onto isx.config by build-kernel.sh. Only options that would be
# wrong or dead on aarch64 belong here; everything shared stays in isx.config.

# ---- KVM paravirt guest ----
# kvmclock keeps the guest clock synced with the host. These are x86 symbols;
# arm64 uses the architected timer and has no pv spinlocks, so kconfig drops
# them there. CONFIG_PARAVIRT itself is shared and stays in isx.config.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y
CONFIG_PARAVIRT_SPINLOCKS=y

# ---- Mitigations off (compile-time) ----
# Equivalent to booting with mitigations=off, so boot scripts need not pass it.
# Only x86_64 lets it be switched off: arm64 forces CPU_MITIGATIONS on, so in
# isx.config it was an option the vm build, which fails on any, cannot apply.
CONFIG_CPU_MITIGATIONS=n

# ---- Syscall User Dispatch ----
# prctl(PR_SET_SYSCALL_USER_DISPATCH), which Wine uses and stock Fedora enables.
# Built whenever GENERIC_SYSCALL was until 7.3, which made it an option that
# allnoconfig turns off. arm64 does not support it.
CONFIG_SYSCALL_USER_DISPATCH=y

# ---- ACPI ----
# x86_64 QEMU needs this for PCI enumeration and for power-off to work.
# aarch64 boots from the device tree instead, and never resolves CONFIG_ACPI
# under allnoconfig, so keeping it here spares the other arch a WARN.
CONFIG_ACPI=y

# ---- Serial: ttyS0 ----
# The real console under QEMU/pc. On aarch64 this driver has no hardware to
# bind to but still publishes /dev/ttyS0..3 stubs, so it is deliberately off
# there -- see isx-aarch64.config.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# ---- RTC: MC146818, as emulated by QEMU ----
CONFIG_RTC_DRV_CMOS=y

# ---- Kernel Compression ----
# x86_64 builds a self-decompressing bzImage, so this shrinks the shipped
# kernel directly. It has no effect on aarch64, whose Image target is
# uncompressed by construction -- that arch is compressed for distribution
# instead, in release.yml.
CONFIG_KERNEL_ZSTD=y
