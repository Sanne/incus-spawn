# incus-spawn VM appliance kernel configuration fragment.
# Applied on top of allnoconfig by build-kernel.sh, which concatenates this
# file with the matching isx-<arch>.config before handing the result to
# kconfig. Options that differ per architecture (serial drivers, RTC, kernel
# self-compression) live in those files, not here -- a single shared fragment
# could only ever set the union, which meant carrying dead drivers on one arch
# and a WARN line for every option the other arch dropped.

# ---- General Setup ----
CONFIG_64BIT=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_POSIX_TIMERS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# Full preemption: reduces seccomp_notify latency from ~100ms (PREEMPT_NONE)
# to ~100us by letting the kernel preempt anywhere. Appropriate for a
# single-purpose VM appliance where throughput penalty is negligible.
CONFIG_PREEMPT=y
# Audit: required by dbus and Incus service sandboxing
CONFIG_AUDIT=y
CONFIG_HAVE_ARCH_AUDITSYSCALL=y
CONFIG_AUDITSYSCALL=y

CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_HZ_1000=y
CONFIG_SCHED_AUTOGROUP=y

CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=n

CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_FILE_LOCKING=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_INOTIFY_USER=y
CONFIG_PRINTK=y
# The printk ring buffer's descriptor arrays are statically sized from this and
# land in .data, so the shift is paid in image bytes, not just at run time:
# kconfig's default of 17 costs 360 KB of struct printk_info plus 96 KB of
# descriptors plus a 128 KB .bss log buffer. 16 halves that for a 64 KB dmesg,
# which still holds a full appliance boot several times over.
CONFIG_LOG_BUF_SHIFT=16
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_SYSCTL=y
CONFIG_EMBEDDED=n

# Binary format support
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ---- KVM paravirt ----
# Only PARAVIRT itself resolves on both arches; the guest-side pieces
# (kvmclock, pv spinlocks) are x86 symbols and live in isx-x86_64.config.
CONFIG_PARAVIRT=y

# ---- Mitigations off (compile-time) ----
# Equivalent to booting with mitigations=off, so boot scripts need not pass it.
# (A built-in CONFIG_CMDLINE for rootfstype=btrfs was tried but doesn't work:
# arm64 7.0 only offers CMDLINE_FROM_BOOTLOADER/FORCE — no EXTEND — so the
# built-in line is ignored when a bootloader cmdline is present, and FORCE would
# discard our dynamic isx.* params. rootfstype lives on the bootloader cmdline.)
CONFIG_CPU_MITIGATIONS=n

# ---- Block Layer ----
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

# ---- PCI ----
CONFIG_PCI=y

# ---- Virtio ----
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y

# Virtio vsock: host<->guest communication channel used by qemu-guest-agent
# for time synchronization (vfkit --timesync, QEMU guest-set-time)
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# ---- Console / TTY ----
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n

# No virtual terminals. The appliance has no display adapter and no keyboard,
# so CONFIG_VT can only bind the dummy console -- while still publishing 64
# unusable /dev/tty0..63 nodes and pulling in the input core, which
# drivers/tty/Kconfig selects unconditionally. Every boot path passes an
# explicit console= (hvc0 under vfkit, ttyS0/ttyAMA0 under QEMU), so there is
# nothing for a VT fallback to do. Leave this off unless someone adds a
# graphical console: without VT, a boot with no console= has no console at all.
CONFIG_VT=n
CONFIG_VT_CONSOLE=n

# HVC: hvc0 (vfkit macOS, via VIRTIO_CONSOLE above)
CONFIG_HVC_DRIVER=y

# The UART drivers are per-arch and live in isx-x86_64.config (8250/ttyS0) and
# isx-aarch64.config (PL011/ttyAMA0).

# ---- Filesystems ----
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
# CONFIG_OVERLAY_FS_METACOPY is not set
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_HUGETLBFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# ---- Networking ----
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_SYN_COOKIES=y
CONFIG_IPV6=y

# Netdevices
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_MACVLAN=y

# Traffic control (required by Incus for container network devices)
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_FQ_CODEL=y

# Bridge
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y

# Netfilter (nftables + iptables NAT + REDIRECT for MITM proxy)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_NUMGEN=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y

# ---- Container Isolation ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# cgroups
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_ZSWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_MISC=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# seccomp_notify performance: process_vm_readv lets incusd read syscall
# args directly from container memory instead of the slow /proc/pid/mem path
CONFIG_CROSS_MEMORY_ATTACH=y

# Checkpoint/restore: seccomp filter introspection, kcmp syscall
CONFIG_CHECKPOINT_RESTORE=y

# ---- Security ----
CONFIG_SECURITY=y
CONFIG_FANOTIFY=y

# ---- Memory ----
CONFIG_SHMEM=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_TRANSPARENT_HUGEPAGE=n
CONFIG_SWAP=y

# ---- Performance ----
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_PERF_EVENTS=y

# ---- Tracing and Profiling ----
# Dynamic ftrace: near-zero overhead when idle (NOPs replace mcount calls until
# a tracer activates). Enables perf tracepoint events, perf sched/lock/irq
# analysis, and the tracefs interface (/sys/kernel/tracing).
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_GRAPH_TRACER=y
# Kprobes: dynamic kernel probes for perf probe, BPF kprobe attachment, and
# bpftrace. Also enables tracepoint-based perf events (sched:*, syscalls:*).
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
# Uprobes: userspace probes -- lets perf probe -x instrument JVM, Node, etc.
# without recompilation. Also the mechanism behind BPF uprobe programs.
CONFIG_UPROBE_EVENTS=y

# ---- Debugging (minimal) ----
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_FS=y

# ---- RTC (lets the kernel read wall time from the emulated clock) ----
# The RTC device drivers themselves are per-arch (MC146818 on x86_64, PL031 on
# aarch64) and live in isx-<arch>.config.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y

# ---- Hardware RNG ----
CONFIG_HW_RANDOM=y
