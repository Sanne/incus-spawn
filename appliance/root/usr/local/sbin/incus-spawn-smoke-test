#!/bin/sh
# Smoke test for the Incus appliance.
# Verifies that Incus daemon, storage pool, and bridge are functional.
# Called from rcS when isx.smoke_test is on the kernel cmdline.
# Output goes to the serial console for CI verification.
#
# The console is read from the kernel cmdline rather than probed for, because a
# device node existing does not mean anything is behind it: the 8250 driver
# registers /dev/ttyS0..3 whether or not hardware answers, so on any target
# whose real console is hvc0 -- vfkit, on Apple silicon *and* Intel Macs, since
# x86_64 keeps that driver -- a fixed probe order lands on a backing-less stub.
# What happens then is arch-dependent and both outcomes are bad: on aarch64 the
# open succeeds and every write is silently discarded, while on x86_64 it fails
# outright, which under "set -eu" exits this script non-zero and, because rcS is
# also "set -eu" and runs us synchronously, aborts the boot before "ISX READY".
# The last console= token wins, matching the kernel's own rule for /dev/console.

set -eu

CONSOLE=""
for tok in $(cat /proc/cmdline); do
    case "$tok" in
        console=*)
            dev="/dev/${tok#console=}"
            [ -c "${dev%%,*}" ] && CONSOLE="${dev%%,*}"
            ;;
    esac
done
if [ -z "$CONSOLE" ]; then
    for dev in /dev/hvc0 /dev/ttyAMA0 /dev/ttyS0; do
        [ -c "$dev" ] && CONSOLE="$dev" && break
    done
fi
[ -z "$CONSOLE" ] && exit 0

exec > "$CONSOLE" 2>&1

fail() {
    echo "=== SMOKE TEST FAILED: $1 ==="
    /usr/local/sbin/incus-spawn-diag
    exit 1
}

echo "=== SMOKE TEST START ==="

incus info > /dev/null 2>&1 || fail "incus daemon not responsive"
echo "  PASS: incus daemon responsive"

incus storage show cow > /dev/null 2>&1 || fail "storage pool 'cow' not found"
echo "  PASS: storage pool 'cow' exists"

incus network show incusbr0 > /dev/null 2>&1 || fail "bridge 'incusbr0' not found"
echo "  PASS: bridge 'incusbr0' exists"

# A default profile with no root disk is what makes every instance creation fail with
# "No root device could be found", and the old version of this check could not see that: a
# rejected creation and an unfetchable image both collapsed into "SKIP: no network to fetch
# image", so a broken profile still reported PASSED.
#
# Two constraints shape the replacement. rcS runs this script synchronously *before* it echoes
# "ISX READY", so nothing here may block on the network — an earlier attempt to fetch an image
# on demand hung the boot past the CI timeout. And the profile invariant is worth asserting even
# when no image is available. So check the profile directly, offline, which is the part that
# actually catches the regression, and attempt a real creation only opportunistically.
#
# These mirror the device names incus-spawn-vm-init writes; here that is the point, since what
# is being verified is that vm-init populated the profile.
incus profile device get default root pool > /dev/null 2>&1 \
    || fail "default profile has no root disk (incus-spawn-vm-init did not populate it)"
echo "  PASS: default profile has a root disk"

incus profile device get default eth0 network > /dev/null 2>&1 \
    || fail "default profile has no NIC (incus-spawn-vm-init did not populate it)"
echo "  PASS: default profile has a NIC"

# Every container's root maps to the same host UID, so they all share one per-UID inotify
# budget. At the 128 default it runs out around the tenth concurrent container and the next
# one's systemd exits before it can log anything — a failure that surfaces only as an
# unhelpful "Failed to get init pid" from lxc attach. rcS applies 99-incus-spawn.conf with
# stderr discarded, so a typo or a knob the custom kernel lacks would fail silently; assert
# the value actually took.
INOTIFY_INSTANCES=$(cat /proc/sys/fs/inotify/max_user_instances 2>/dev/null || echo 0)
[ "$INOTIFY_INSTANCES" -ge 1024 ] \
    || fail "fs.inotify.max_user_instances is $INOTIFY_INSTANCES (99-incus-spawn.conf did not apply)"
echo "  PASS: inotify instance limit raised ($INOTIFY_INSTANCES)"

# With bridge netfilter calling iptables, the gateway's :443 DNAT happens before the per-NIC
# chains, and the --proxy-only ACL drops every connection to the proxy (#1137).
BRIDGE_NF=$(cat /proc/sys/net/bridge/bridge-nf-call-iptables 2>/dev/null || echo 0)
[ "$BRIDGE_NF" = 0 ] \
    || fail "net.bridge.bridge-nf-call-iptables is $BRIDGE_NF: the --proxy-only ACL would drop the proxy's DNAT'd connections"
echo "  PASS: bridged frames skip iptables (the gateway's DNAT runs after the --proxy-only ACL)"

# security.ipv4_filtering is what makes the proxy's source-IP identity unforgeable, and Incus's
# nftables driver enforces it in an nft "bridge"-family table. A kernel without that family
# accepts the setting and fails only when an instance starts, and isx then starts it with
# filtering off (#905) -- so a config trim that drops CONFIG_NF_TABLES_BRIDGE would silently
# re-open the hole on every Mac. Nothing else here would notice; this does, offline.
if ! nft add table bridge isx_smoke > /tmp/smoke-nft.log 2>&1; then
    cat /tmp/smoke-nft.log
    fail "kernel lacks the nft bridge family (CONFIG_NF_TABLES_BRIDGE); security.ipv4_filtering cannot be enforced"
fi
echo "  PASS: nft bridge family available (security.ipv4_filtering enforceable)"

# --proxy-only is an Incus network ACL on the NIC (#1137), whose chains in that table match
# "ct state", which the bridge family accepts only with bridge conntrack
# (CONFIG_NF_CONNTRACK_BRIDGE). Without it every proxy-only start fails: closed, but unusable.
if ! { nft add chain bridge isx_smoke acl '{ type filter hook input priority 0; }' \
        && nft add rule bridge isx_smoke acl ct state established,related accept; } > /tmp/smoke-nft.log 2>&1; then
    cat /tmp/smoke-nft.log
    nft delete table bridge isx_smoke
    fail "kernel lacks bridge conntrack (CONFIG_NF_CONNTRACK_BRIDGE); --proxy-only cannot be enforced"
fi
nft delete table bridge isx_smoke
echo "  PASS: bridge conntrack available (--proxy-only enforceable)"

# Rootful Podman's netavark accepts forwarded traffic by "ct mark", and nft refuses its whole
# ruleset without connection marks (CONFIG_NF_CONNTRACK_MARK, #2003): no container in a
# container on this kernel would start on a bridge network.
if ! { nft add table inet isx_smoke && nft add chain inet isx_smoke marks \
        && nft add rule inet isx_smoke marks ct mark 0x1000 accept; } > /tmp/smoke-nft.log 2>&1; then
    cat /tmp/smoke-nft.log
    nft delete table inet isx_smoke 2>/dev/null || true
    fail "kernel lacks connection marks (CONFIG_NF_CONNTRACK_MARK); rootful Podman cannot start a bridged container"
fi
nft delete table inet isx_smoke
echo "  PASS: connection marks available (rootful Podman's bridge networks)"

# Filter to CONTAINER images — picking a VIRTUAL-MACHINE image would fail creation spuriously.
IMAGE=$(incus image list --format csv --columns ft 2>/dev/null \
    | grep -i ',container' | head -n1 | cut -d, -f1)

if [ -z "$IMAGE" ]; then
    # Deliberately does not fetch one: see above. The profile is already covered.
    echo "  SKIP: container creation (no image cached locally; not fetching during boot)"
else
    if ! incus init "$IMAGE" smoke --no-start > /tmp/smoke-init.log 2>&1; then
        echo "  --- incus init output ---"
        cat /tmp/smoke-init.log
        fail "container creation rejected (default profile may lack a root disk)"
    fi
    incus delete smoke > /dev/null 2>&1 || true
    echo "  PASS: container creation works"
fi

# incusd's local listener peeks 8 bytes of every new connection to detect a STARTTLS upgrade.
# Before lxc/incus@2cb2549 it did so inside Accept() with no deadline, so one client that sent
# fewer than 8 bytes stalled every new API connection behind it (#791 B.1: about 179s through
# vfkit, until the forwarder's socat -T reaped it). The fix, backported by build.sh (#1313),
# classifies each connection in its own goroutine under a 3s read deadline. So: other clients
# are served while a silent or partial one is held open, well before that deadline, and incusd
# then closes the held one itself. Every held connection gives up on its own after 8s, so a
# failure here leaves nothing behind.
[ -r /etc/isx-incus ] && sed 's/^/  INFO: /' /etc/isx-incus
SOCK=/var/lib/incus/unix.socket
now_ms() { awk '{ printf "%d\n", $1 * 1000 }' /proc/uptime; }

# One GET /1.0 on a new connection, bounded. shut-none keeps socat from half-closing once the
# request is written; incusd closes the connection after the response, and socat exits then.
probe() {
    printf 'GET /1.0 HTTP/1.1\r\nHost: incus\r\nConnection: close\r\n\r\n' \
        | timeout 5 socat -t 5 - UNIX-CONNECT:"$SOCK",shut-none 2>/dev/null \
        | grep -q '"status_code":200'
}

# Open a connection that sends $1 (possibly nothing) and then nothing more for 8s, and wait
# until it is connected. $HELD is the socat holding it, which exits once incusd closes it.
hold() {
    ( printf '%s' "$1"; exec sleep 8 ) | socat -t 0.1 - UNIX-CONNECT:"$SOCK" > /dev/null 2>&1 &
    HELD=$!
    i=0
    while [ $i -lt 20 ] && ! ls -l /proc/"$HELD"/fd 2>/dev/null | grep -q 'socket:'; do
        sleep 0.05
        i=$((i + 1))
    done
}

# Whether process $1 is still running. Not kill -0: a non-interactive ash reaps its background
# children only on wait, so one that exited stays a zombie and kill -0 still succeeds on it.
running() { [ -r /proc/"$1"/stat ] && [ "$(cut -d' ' -f3 /proc/"$1"/stat)" != Z ]; }

# Wait for every pid in $@ to exit, up to 8s; prints the ms elapsed since $T0.
wait_closed() {
    i=0
    while [ $i -lt 80 ]; do
        alive=0
        for p in "$@"; do running "$p" && alive=1; done
        [ $alive = 0 ] && break
        sleep 0.1
        i=$((i + 1))
    done
    echo $(( $(now_ms) - T0 ))
}

# A connection that has sent $1 must not hold up a request on another one, and incusd must
# close it near the 3s deadline: not at once (it would refuse slow clients), and not only
# when the client gives up after 8s.
check_held() {
    T0=$(now_ms)
    hold "$1"
    probe || fail "a request waited behind a connection that sent $2 (StarttlsListener peek)"
    served=$(( $(now_ms) - T0 ))
    running "$HELD" || fail "the connection that sent $2 closed before the request was served"
    [ "$served" -lt 2500 ] || fail "a request next to a connection that sent $2 took ${served}ms"
    echo "  PASS: request served in ${served}ms past a connection that sent $2"
    closed=$(wait_closed "$HELD")
    [ "$closed" -ge 2500 ] && [ "$closed" -le 7000 ] \
        || fail "incusd closed the connection that sent $2 after ${closed}ms, not near its 3s deadline"
    echo "  PASS: incusd closed the connection that sent $2 after ${closed}ms"
}

T0=$(now_ms)
probe || fail "GET /1.0 on the local socket"
echo "  INFO: GET /1.0 on the local socket takes $(( $(now_ms) - T0 ))ms"
check_held "" "nothing"
check_held "GET /1." "7 bytes"

# A slow client is not a silent one: a request completed within the deadline is still served.
( printf 'GET /1.'; sleep 1; printf '0 HTTP/1.1\r\nHost: incus\r\nConnection: close\r\n\r\n'; exec sleep 2 ) \
    | timeout 8 socat -t 0.1 - UNIX-CONNECT:"$SOCK" 2> /dev/null | grep -q '"status_code":200' \
    || fail "a request completed 1s after its first bytes was not served"
echo "  PASS: a request completed 1s after its first bytes is served"

# Several at once: each is classified on its own, so none of them holds up the others. Timed
# from once all 8 are connected, so slow process starts (aarch64 under TCG) do not count.
pids=""
for b in "" "" "" "" "GET /1." "GET /1." "GET /1." "GET /1."; do
    hold "$b"
    pids="$pids $HELD"
done
T0=$(now_ms)
probe && probe && probe || fail "requests waited behind 8 silent and partial connections"
served=$(( $(now_ms) - T0 ))
for p in $pids; do running "$p" || fail "a held connection closed before the 3 requests were served"; done
[ "$served" -lt 2500 ] || fail "3 requests next to 8 silent and partial connections took ${served}ms"
echo "  PASS: 3 requests served in ${served}ms past 8 silent and partial connections"
# shellcheck disable=SC2086
closed=$(wait_closed $pids)
[ "$closed" -le 7000 ] || fail "8 silent and partial connections still open after ${closed}ms"
echo "  PASS: incusd closed all 8 after ${closed}ms"

echo "=== SMOKE TEST PASSED ==="
