#!/bin/sh
# Allowlisted control agent, reached from the macOS host over a dedicated vsock port
# (one verb per connection, via `socat ... EXEC:`). This is intentionally NOT a general
# guest-exec channel: it dispatches only the fixed verbs below, so the host can introspect
# and recover the forwarder without granting arbitrary in-guest command execution.
#
# Protocol: read one verb line from stdin, write the result to stdout, exit.

# The forwarder's distinctive cmdline fragment — matches the parent and every fork child,
# and nothing else (the agent's own socat uses EXEC:, not UNIX-CONNECT).
FORWARDER_MATCH='UNIX-CONNECT:/var/lib/incus/unix.socket'
INCUS_VSOCK_PORT=8443
POOL_MOUNT_PREFIX=/var/lib/incus/storage-pools

# The btrfs filesystem UUID (its /sys/fs/btrfs/<fsid> directory name) backing path $1, or nothing.
# btrfs st_dev numbers are per-subvolume, so neither stat nor mountinfo's major:minor identify the
# block device; the mount's *source* does. Take the btrfs mount whose mount point is the longest
# prefix of the path, resolve its source device, and find the fsid whose devices/ lists that name.
# Mirrors BtrfsSysfs.java on the Linux host — keep the two lookups in step.
btrfs_fsid() {
    src=$(awk -v p="$1" '{
        mp = $5; i = index($0, " - "); split(substr($0, i + 3), r, " ");
        if (r[1] != "btrfs") next;
        if (p == mp || mp == "/" || index(p, mp "/") == 1) {
            if (length(mp) > best) { best = length(mp); s = r[2] }
        }
    } END { print s }' /proc/self/mountinfo)
    [ -n "$src" ] || return 0
    name=$(basename "$(readlink -f "$src" 2>/dev/null || echo "$src")")
    for d in /sys/fs/btrfs/*/devices/"$name"; do
        if [ -e "$d" ]; then
            basename "$(dirname "$(dirname "$d")")"
            return 0
        fi
    done
}

# Pool names are interpolated into a path, so reject anything that isn't a plain pool name —
# this is a separate trust boundary, so it validates independently of the host (mirrors
# BtrfsUsage.isSafePoolName). Prints the rejection and returns 1 on a bad name.
valid_pool() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) echo "error: bad pool name"; return 1 ;;
    esac
    return 0
}

# One line per connection: "<verb> [arg] [opt] [extra]". arg, opt and extra are optional and only
# consumed by verbs that declare them (the btrfs-* verbs); all three are always validated before
# use. For the btrfs-* verbs, arg is always the pool name.
read -r verb arg opt extra || exit 0

case "$verb" in
    ping)
        echo ok
        ;;
    version)
        if [ -r /etc/isx-version ]; then cat /etc/isx-version; else echo "error: no version"; fi
        ;;
    socat-count)
        # In-guest count of forwarder socat processes (parent + per-connection children).
        # Compared against the host-side vfkit fd count, this locates where streams leak:
        # if this is low while the host count is high, vfkit is not reaping (link 2);
        # if both are high, the forwarder is lingering children (link 3).
        pgrep -f "$FORWARDER_MATCH" 2>/dev/null | wc -l | tr -d '[:space:]'
        echo
        ;;
    sshd-status)
        if pgrep -x sshd >/dev/null 2>&1; then echo running; else echo stopped; fi
        ;;
    forwarder-restart)
        # Recover a leaked/wedged forwarder without rebooting the VM: drop every forwarder
        # socat (parent + children, freeing the host fds vfkit pinned) and relaunch it.
        # The agent's own listener is untouched (different cmdline).
        #
        # Detach the relaunch with setsid so the new forwarder neither inherits this
        # connection's socket fds (which would leave a dangling dup) nor shares our process
        # group (so socat tearing this connection down can't signal it). Stderr goes to
        # /dev/console (the virtio-serial that feeds vm.log) so socat startup failures are
        # visible — the boot-time launch inherits the console naturally, but earlier versions
        # of this restart redirected to /dev/null, hiding any bind/socket errors.
        pkill -f "$FORWARDER_MATCH" 2>/dev/null || true
        sleep 1
        setsid /usr/local/sbin/isx-start-vsock-forwarder "$INCUS_VSOCK_PORT" </dev/null >/dev/console 2>&1 &
        # Verify the forwarder survived startup (bind, missing socket, etc.) before confirming.
        i=0
        while [ $i -lt 4 ]; do
            sleep 0.5
            if pgrep -f "$FORWARDER_MATCH" >/dev/null 2>&1; then
                echo restarted
                exit 0
            fi
            i=$((i + 1))
        done
        echo "error: forwarder process not found after restart"
        ;;
    btrfs-usage)
        # Per-subvolume referenced/exclusive sizes for a btrfs pool. Runs here because the pool
        # lives in the VM and only root can read /var/lib/incus/storage-pools (0700). Both outputs
        # are read-only introspection; the host joins them (see BtrfsUsage.parse). The
        # "---ISX-SUBVOL---" delimiter mirrors BtrfsUsage.AGENT_SECTION_MARKER — keep both in sync
        # if either is renamed.
        valid_pool "$arg" || exit 0
        # Optional, allowlisted second token: "sync" adds --sync (force a commit before reading, so
        # accounting reflects still-uncommitted writes — used right after a build); anything else
        # than empty/sync is rejected. Mirrors the Linux path in BtrfsUsage.probe(pool, sync) —
        # keep the two flavours in step.
        case "$opt" in
            sync) sync_flag=--sync ;;
            '')   sync_flag= ;;
            *)    echo "error: bad option"; exit 0 ;;
        esac
        mount="$POOL_MOUNT_PREFIX/$arg"
        btrfs qgroup show -re --raw $sync_flag "$mount" 2>/dev/null || true
        echo "---ISX-SUBVOL---"
        btrfs subvolume list "$mount" 2>/dev/null || true
        ;;
    btrfs-status)
        # Whether the pool's qgroup accounting can be trusted, straight from the kernel's sysfs
        # attributes (world-readable, but the lookup needs mountinfo for the VM's own mounts, so it
        # lives here). key=value lines for BtrfsUsage.parseStatus; "available=0" when the fsid or
        # its qgroups/ directory (quota off, or a kernel without the attributes) can't be found.
        # The `inconsistent` flag is the one that matters: set when quotas were enabled on a
        # populated pool or a subvolume delete exceeded drop_subtree_threshold — every counter is
        # frozen until a rescan, and nothing clears it on its own.
        valid_pool "$arg" || exit 0
        fsid=$(btrfs_fsid "$POOL_MOUNT_PREFIX/$arg")
        q="/sys/fs/btrfs/$fsid/qgroups"
        if [ -z "$fsid" ] || [ ! -d "$q" ]; then
            echo "available=0"
        else
            for f in enabled inconsistent mode drop_subtree_threshold; do
                [ -r "$q/$f" ] && echo "$f=$(cat "$q/$f")"
            done
        fi
        ;;
    btrfs-rescan)
        # Start a `btrfs quota rescan` for the pool: the kernel rebuilds every qgroup counter from
        # the extent tree in the background and clears `inconsistent` when done. Non-destructive
        # (accounting only, never data). Returns immediately — the host polls btrfs-status.
        # "running" means one was already in flight (btrfs-progs reports that as an error).
        valid_pool "$arg" || exit 0
        out=$(btrfs quota rescan "$POOL_MOUNT_PREFIX/$arg" 2>&1)
        rc=$?
        if [ $rc -eq 0 ]; then
            echo started
        elif echo "$out" | grep -qi "in progress"; then
            echo running
        else
            echo "error: $out"
        fi
        ;;
    btrfs-orphan-delete)
        # Removes one orphaned subvolume so the rest of the pool is untouched (#874) — isx
        # doctor's only destructive-but-targeted alternative to wiping the whole pool with
        # 'isx vm reset'.
        valid_pool "$arg" || exit 0
        case "$opt" in
            containers) itype=container ;;
            virtual-machines) itype=virtual-machine ;;
            *) echo "error: bad kind"; exit 0 ;;
        esac
        # A leading '.' or '-' is rejected outright, not just filtered by charset: '.' and '..'
        # are themselves valid A-Za-z0-9._- strings, and '..' resolved by 'btrfs subvolume
        # delete -R' against the pool root deletes every instance, image and snapshot on it
        # (review on #874 -- the pool root is itself a btrfs subvolume, so 'subvolume show'
        # accepts it, and nothing is ever named '..' so the Incus re-check below passes too).
        case "$extra" in
            ''|.*|-*|*[!A-Za-z0-9._-]*) echo "error: bad name"; exit 0 ;;
        esac
        name="$extra"
        path="$POOL_MOUNT_PREFIX/$arg/$opt/$name"
        # Not "path exists": Incus 6.23 recreates a plain directory (with backup.yaml) at a
        # dangling record's path whenever it rewrites that record, and that is not this
        # orphan's data.
        btrfs subvolume show "$path" >/dev/null 2>&1 || { echo "error: not a subvolume"; exit 0; }
        # Re-check here, inside the VM, that nothing in Incus -- any project -- still
        # references this name: a separate trust boundary from whatever the host's own scan
        # claims. On disk, a non-default project's subvolume is "<project>_<name>", so each
        # project's bare names are joined back onto its prefix before comparing against $name.
        # 'incus project list' marks the active project "<name> (current)", even with -f csv;
        # stripped here, or the unquoted word-split loop below also iterates "(current)" as a
        # project of its own and every 'incus' call against it fails (review on #874).
        projects=$(incus project list -f csv -c n 2>/dev/null | sed 's/ (current)$//')
        if [ $? -ne 0 ] || [ -z "$projects" ]; then
            echo "error: could not list projects"
            exit 0
        fi
        found=
        for proj in $projects; do
            prefix=
            [ "$proj" = default ] || prefix="${proj}_"
            insts=$(incus list --project "$proj" -f csv -c n 2>/dev/null)
            [ $? -eq 0 ] || { echo "error: could not list instances"; exit 0; }
            for inst in $insts; do
                [ "$prefix$inst" = "$name" ] && { found=1; break; }
            done
            [ -n "$found" ] && break
            # 'storage volume list' has no --type flag (review on #874, confirmed against Incus
            # 6.23): the type is a positional filter, before --project.
            vols=$(incus storage volume list "$arg" "type=$itype" --project "$proj" -f csv -c n 2>/dev/null)
            [ $? -eq 0 ] || { echo "error: could not list volumes"; exit 0; }
            for vol in $vols; do
                [ "$prefix$vol" = "$name" ] && { found=1; break; }
            done
            [ -n "$found" ] && break
        done
        if [ -n "$found" ]; then
            echo "error: still referenced by Incus"
            exit 0
        fi
        if btrfs subvolume delete -R "$path" >/dev/null 2>&1; then
            echo deleted
        else
            echo "error: delete failed"
        fi
        ;;
    *)
        echo "error: unknown verb"
        ;;
esac
