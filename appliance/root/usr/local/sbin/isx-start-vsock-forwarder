#!/bin/sh
# Launch the Incus API vsock forwarder. Shared by incus-spawn-vm-init at boot and by
# isx-agent when recovering a leaked/wedged forwarder, so the socat invocation lives in
# exactly one place. The optional second argument points it at another socket: only the
# test-only silent endpoint uses it (isx.test_silent_vsock in incus-spawn-vm-init), so the
# -T backstop is timed with exactly this invocation.
#
# -T 180: total inactivity timeout. Each accepted connection forks a child; a close that
# never propagates across the vsock boundary would otherwise leave that child (and the
# host-side connection it holds) alive forever. The 180s floor sits above the Incus /wait
# long-poll (up to 120s of legitimate silence) and the client request watchdog (150s);
# live exec fds are keepalived (~15s) so they are never reaped. See incus-spawn-vm-init.
#
# backlog=128: socat's default listen backlog is 5, and a vsock listener whose accept queue
# is full refuses the connection outright. One isx exec opens about five connections at once
# (four fd WebSockets plus /wait), so the default refused real client traffic under any
# overlap. Measured in CI: 3 of 16 and 12 of 32 concurrent connects refused (#774).
set -eu

PORT="${1:?usage: isx-start-vsock-forwarder <vsock-port> [unix-socket]}"
TARGET="${2:-/var/lib/incus/unix.socket}"

# isx-agent's forwarder-restart refuses until the Incus forwarder has been started once (#2555): the
# agent answers from before vm-init's wait for Incus, and a restart then would start a second one.
# Written here, just before the exec, so it never exists while no forwarder is starting.
if [ "$TARGET" = /var/lib/incus/unix.socket ]; then : > /run/isx-forwarder-started; fi

exec socat -b 65536 -T 180 VSOCK-LISTEN:"$PORT",reuseaddr,fork,backlog=128 \
    UNIX-CONNECT:"$TARGET"
