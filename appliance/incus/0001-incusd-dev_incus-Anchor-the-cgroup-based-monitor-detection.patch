Backport of lxc/incus@cf2d213bb64f11c024aa5624c15bd239f3f5ec89 (stable-7.0; on main as
83eaa5e19) to v7.0.2 for the isx appliance (Sanne/incus-spawn#2104), unchanged: the fix for
GHSA-v736-5xp3-jghf, which v7.0.2 lacks although it carries the cgroup fallback the advisory
is about. Remove this file once INCUS_VERSION is a release that contains the commit (7.0.3).

From cf2d213bb64f11c024aa5624c15bd239f3f5ec89 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Fri, 25 Sep 2026 16:01:18 -0400
Subject: [PATCH] incusd/dev_incus: Anchor the cgroup based monitor
 detection
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The cgroup fallback accepted the first lxc.monitor. found anywhere in
the path, so a container could create a cgroup named after another
container below its own and be identified as it. Only trust the first
lxc.payload. or lxc.monitor. component, which a container can't forge.

This addresses GHSA-v736-5xp3-jghf (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
---
 cmd/incusd/dev_incus.go | 28 ++++++++++++++++++++++++----
 1 file changed, 24 insertions(+), 4 deletions(-)

diff --git a/cmd/incusd/dev_incus.go b/cmd/incusd/dev_incus.go
index 883d8d86c..4e6e6d04f 100644
--- a/cmd/incusd/dev_incus.go
+++ b/cmd/incusd/dev_incus.go
@@ -427,6 +427,29 @@ func loadContainerForMonitorName(name string, s *state.State) (instance.Containe
 	return c, nil
 }
 
+// containerNameFromCgroup extracts the container name from a /proc/<pid>/cgroup content.
+// Only the first lxc.payload. or lxc.monitor. path component is trusted, as a container
+// can create arbitrarily named cgroups below its own payload cgroup.
+func containerNameFromCgroup(content string) (string, bool) {
+	for line := range strings.SplitSeq(content, "\n") {
+		_, path, found := strings.Cut(line, ":/")
+		if !found {
+			continue
+		}
+
+		for component := range strings.SplitSeq(path, "/") {
+			for _, prefix := range []string{"lxc.payload.", "lxc.monitor."} {
+				name, found := strings.CutPrefix(component, prefix)
+				if found && name != "" {
+					return name, true
+				}
+			}
+		}
+	}
+
+	return "", false
+}
+
 func findContainerForPid(pid int32, s *state.State) (instance.Container, error) {
 	/*
 	 * Try and figure out which container a pid is in. There is probably a
@@ -469,11 +492,8 @@ func findContainerForPid(pid int32, s *state.State) (instance.Container, error)
 		// In containerized deployments the monitor's cmdline can be empty, fall back to its cgroup path.
 		cgroup, err := os.ReadFile(fmt.Sprintf("/proc/%d/cgroup", pid))
 		if err == nil {
-			_, name, found := strings.Cut(string(cgroup), "/lxc.monitor.")
+			name, found := containerNameFromCgroup(string(cgroup))
 			if found {
-				name, _, _ = strings.Cut(name, "\n")
-				name, _, _ = strings.Cut(name, "/")
-
 				return loadContainerForMonitorName(name, s)
 			}
 		}
