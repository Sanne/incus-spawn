diff --git a/internal/server/backup/backup_config_utils.go b/internal/server/backup/backup_config_utils.go
index 3af156e77..7f6b5b8e3 100644
--- a/internal/server/backup/backup_config_utils.go
+++ b/internal/server/backup/backup_config_utils.go
@@ -199,9 +199,13 @@ func UpdateInstanceConfig(c *db.Cluster, b Info, mountPath string) error {
 		return errors.New("No root device could be found")
 	}
 
-	// Write updated backup.yaml file.
+	// Delete then recreate with O_EXCL so we never write through a planted hard link or symlink.
+	err = os.Remove(backupFilePath)
+	if err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
 
-	file, err := os.Create(backupFilePath)
