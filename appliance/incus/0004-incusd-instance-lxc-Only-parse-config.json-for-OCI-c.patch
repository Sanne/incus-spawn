Backport of lxc/incus@e298fc7880b718398d2d8b4efd8b23bffc6d317d (stable-7.0; on main as
084e2d482) to v7.0.2 for the isx appliance (Sanne/incus-spawn#2104), unchanged: part of the fix for
GHSA-3wxw-5gh2-j2x2: config.json is parsed only for OCI containers, so no imported image can turn
its instance into an application container by shipping one.
Remove this file once INCUS_VERSION is a release that contains the commit (the next 7.0
release; 7.0.3 is not out yet).

From e298fc7880b718398d2d8b4efd8b23bffc6d317d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?St=C3=A9phane=20Graber?= <stgraber@stgraber.org>
Date: Fri, 25 Sep 2026 10:28:16 -0400
Subject: [PATCH] incusd/instance/lxc: Only parse config.json for OCI
 containers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The OCI config was parsed whenever config.json exists in the instance
directory, so any imported image could turn its instance into an
application container. Restore the image type check that was in place
before the environment export was moved to instance start.

This addresses GHSA-3wxw-5gh2-j2x2 (CVE pending)

Signed-off-by: Stéphane Graber <stgraber@stgraber.org>
---
 .../server/instance/drivers/driver_lxc.go     | 80 ++++++++++++++-----
 1 file changed, 60 insertions(+), 20 deletions(-)

diff --git a/internal/server/instance/drivers/driver_lxc.go b/internal/server/instance/drivers/driver_lxc.go
index 78a79536d..c62d4c8b5 100644
--- a/internal/server/instance/drivers/driver_lxc.go
+++ b/internal/server/instance/drivers/driver_lxc.go
@@ -18,6 +18,7 @@ import (
 	"os/exec"
 	"path"
 	"path/filepath"
+	"regexp"
 	"runtime"
 	"slices"
 	"sort"
@@ -33,6 +34,7 @@ import (
 	"github.com/gorilla/websocket"
 	"github.com/kballard/go-shellquote"
 	liblxc "github.com/lxc/go-lxc"
+	ociSpecs "github.com/opencontainers/runtime-spec/specs-go"
 	"github.com/pkg/sftp"
 	yaml "go.yaml.in/yaml/v4"
 	"golang.org/x/sync/errgroup"
@@ -176,6 +178,11 @@ func lxcSetConfigItem(c *liblxc.Container, key string, value string) error {
 	return nil
 }
 
+// isOCI returns whether the container was created from an OCI image.
+func (d *lxc) isOCI() bool {
+	return util.IsTrue(d.expandedConfig["volatile.container.oci"]) || d.localConfig["image.type"] == "oci"
+}
+
 // lxcEncodeCmd encodes a command for lxc.init.cmd/lxc.execute.cmd, whose
 // parser only supports whole-word quoting with no escape sequences.
 func lxcEncodeCmd(args []string) (string, error) {
@@ -202,6 +209,27 @@ func lxcEncodeCmd(args []string) (string, error) {
 	return strings.Join(words, " "), nil
 }
 
+var ociTmpfsOptionValue = regexp.MustCompile(`^(gid|mode|nr_blocks|nr_inodes|size|uid)=[0-9a-zA-Z%]+$`)
+
+// lxcEncodeOCITmpfs encodes an OCI tmpfs mount as a lxc.mount.entry value from validated parts only.
+// The config comes from the image, so nothing that could turn the entry into another kind of mount is kept.
+func lxcEncodeOCITmpfs(destination string, options []string) (string, error) {
+	target := strings.TrimLeft(destination, "/")
+	if target == "" || strings.ContainsAny(target, " \t\n\v\f\r\\") {
+		return "", fmt.Errorf("Invalid OCI mount destination: %q", destination)
+	}
+
+	flags := []string{"async", "atime", "defaults", "dev", "diratime", "dirsync", "exec", "noatime", "nodev", "nodiratime", "noexec", "norelatime", "nostrictatime", "nosuid", "relatime", "ro", "rw", "strictatime", "suid", "sync"}
+
+	for _, option := range options {
+		if !slices.Contains(flags, option) && !ociTmpfsOptionValue.MatchString(option) {
+			return "", fmt.Errorf("Invalid OCI mount option for %q: %q", destination, option)
+		}
+	}
+
+	return fmt.Sprintf("none %s tmpfs %s 0 0", target, strings.Join(append(slices.Clone(options), "create=dir"), ",")), nil
+}
+
 func lxcStatusCode(lxcState liblxc.State) api.StatusCode {
 	return map[int]api.StatusCode{
 		1: api.Stopped,
@@ -2518,9 +2546,12 @@ func (d *lxc) startCommon() (string, []func() error, error) {
 	}
 
 	// Handle application containers.
-	config, err := instance.OCISpec(d.Path())
-	if err != nil {
-		return "", nil, err
+	var config *ociSpecs.Spec
+	if d.isOCI() {
+		config, err = instance.OCISpec(d.Path())
+		if err != nil {
+			return "", nil, err
+		}
 	}
 
 	if config != nil {
@@ -2668,16 +2699,23 @@ func (d *lxc) startCommon() (string, []func() error, error) {
 			}
 
 			// Skip all our own mounts.
-			if slices.Contains(lxcMounts, filepath.Clean(mount.Destination)) {
+			destination := filepath.Clean("/" + mount.Destination)
+			if slices.Contains(lxcMounts, destination) {
 				continue
 			}
 
-			err := lxcSetConfigItem(cc, "lxc.mount.entry", fmt.Sprintf("%s %s %s %s 0 0", mount.Source, strings.TrimLeft(mount.Destination, "/"), mount.Type, strings.Join(append(mount.Options, "create=dir"), ",")))
+			// Never pass the image's own source, type or options through to liblxc.
+			entry, err := lxcEncodeOCITmpfs(destination, mount.Options)
+			if err != nil {
+				return "", nil, err
+			}
+
+			err = lxcSetConfigItem(cc, "lxc.mount.entry", entry)
 			if err != nil {
 				return "", nil, err
 			}
 
-			lxcMounts = append(lxcMounts, mount.Destination)
+			lxcMounts = append(lxcMounts, destination)
 		}
 
 		// Mount /run as a tmpfs if it isn't already mounted and the image's /run is empty.
@@ -3182,22 +3220,24 @@ func (d *lxc) start(stateful bool, op *operationlock.InstanceOperation) error {
 	}
 
 	// Add the image environment of application containers.
-	spec, err := instance.OCISpec(d.Path())
-	if err != nil {
-		op.Done(err)
-		return err
-	}
+	if d.isOCI() {
+		spec, err := instance.OCISpec(d.Path())
+		if err != nil {
+			op.Done(err)
+			return err
+		}
 
-	ociEnv, err := instance.OCIEnvironment(spec)
-	if err != nil {
-		op.Done(err)
-		return err
-	}
+		ociEnv, err := instance.OCIEnvironment(spec)
+		if err != nil {
+			op.Done(err)
+			return err
+		}
 
-	for k, v := range ociEnv {
-		_, ok := envDict[k]
-		if !ok {
-			envDict[k] = v
+		for k, v := range ociEnv {
+			_, ok := envDict[k]
+			if !ok {
+				envDict[k] = v
+			}
 		}
 	}
 
-- 
