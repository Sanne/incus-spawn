# The cloud images the host-distro jobs boot (#1972): one URL and the publisher's SHA-256 each, read by
# the job's "Read the pinned cloud image" step. They live here, not in test-integration.yml, so the
# upstream watch can bump them: its app may not change a workflow file (docs/dev/UPSTREAM-SETUP.md).
# The items `arch-cloud-image` and `ubuntu-cloud-image` of upstream/manifest.yaml move them; each
# SHA-256 is the line of the publisher's signed sums file for the image (Arch's .SHA256 with its
# .sig, Ubuntu's SHA256SUMS with its .gpg), checked against the publisher's key by the engine.
ARCH_IMAGE_URL=https://geo.mirror.pkgbuild.com/images/v20261101.620452/Arch-Linux-x86_64-cloudimg-20261101.620452.qcow2
ARCH_IMAGE_SHA256=794eb4889b39e1f0ed7d5ae998b2a1ed2137db8cf8c3476cf2962c7437ecb003
UBUNTU_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.img
UBUNTU_IMAGE_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94
