#!/bin/bash
# Git remote helper for isx:// URLs — delegates to isx git-remote-helper
# Installed alongside the isx binary; git discovers it via PATH.
url="$2"
[[ "$url" == isx://* ]] || { echo "error: not an isx:// URL: $url" >&2; exit 1; }
instance="${url#isx://}"
path="/${instance#*/}"
instance="${instance%%/*}"
# An absolute in-instance path produces a double slash in the URL
# (isx://inst//abs/path — separator slash + the path's own leading slash).
# Strip the encoding back to a single leading slash for the exec.
# Old-style single-slash URLs already have a plain /abs/path here.
[[ "$path" == //* ]] && path="${path:1}"
while IFS= read -r line; do
    case "$line" in
        capabilities) printf 'connect\n\n' ;;
        connect\ *) printf '\n'; exec isx git-remote-helper "$instance" "${line#connect }" "$path" ;;
        '') exit 0 ;;
    esac
done
